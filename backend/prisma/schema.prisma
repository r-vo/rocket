// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Nutzer {
  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  passwortHash       String
  istAdmin           Boolean  @default(false)
  aktiv              Boolean  @default(true)
  erstelltAm         DateTime @default(now())
  // JSON-Array der Modul-Schlüssel, die der Nutzer für sich deaktiviert hat (siehe
  // src/utils/module.js). Fehlt ein Schlüssel hier, ist das Modul aktiv — so sind neue,
  // künftige Module automatisch für alle Nutzer aktiv, ohne dass ein Backfill nötig ist.
  deaktivierteModule String   @default("[]")

  sitzungen            Sitzung[]
  profil               NutzerProfil?
  ernaehrungseintraege Ernaehrungseintrag[]
  gewichtseintraege    Gewichtseintrag[]
  planpunkte           Planpunkt[]
  fortschrittsfotos    Fortschrittsfoto[]
  aufgaben             Aufgabe[]
  habits               Habit[]
  buecher              Buch[]
  buchNotizen          BuchNotiz[]
}

// DB-gestützte Sitzung statt JWT: ermöglicht sofortiges serverseitiges Invalidieren bei
// "Abmelden" (die im ersten Entwurf gefundene Lücke, siehe Konzept-Dokument vom 2026-10-27).
// Gespeichert wird nur der Hash des Tokens, nicht das Token selbst.
model Sitzung {
  id         Int      @id @default(autoincrement())
  nutzerId   Int
  tokenHash  String   @unique
  erstelltAm DateTime @default(now())
  gueltigBis DateTime

  nutzer Nutzer @relation(fields: [nutzerId], references: [id], onDelete: Cascade)
}

// Profil-/Zieldaten für die Ernährungsplanung (entspricht S.p aus dem ersten Entwurf,
// ohne name/kg — Name kommt vom Nutzer, aktuelles Gewicht aus Gewichtseintrag).
model NutzerProfil {
  id              Int     @id @default(autoincrement())
  nutzerId        Int     @unique
  alter           Int?
  geschlecht      String?
  groesseCm       Float?
  gewichtZielKg   Float?
  nettoCarbsZielG Int?
  alltagFaktor    Float?
  trainingstage   Int?
  equipment       String?
  tempo           String?
  zieldatum       String?
  extraDefizit    Int?

  nutzer Nutzer @relation(fields: [nutzerId], references: [id], onDelete: Cascade)
}

model Ernaehrungseintrag {
  id          Int      @id @default(autoincrement())
  nutzerId    Int
  datum       String // yyyy-mm-dd
  mahlzeit    String
  bezeichnung String
  menge       Float?
  einheit     String?
  kcal        Int
  nettoCarbs  Float
  fett        Float
  eiweiss     Float
  erstelltAm  DateTime @default(now())

  nutzer Nutzer @relation(fields: [nutzerId], references: [id], onDelete: Cascade)
}

model Gewichtseintrag {
  id       Int    @id @default(autoincrement())
  nutzerId Int
  datum    String // yyyy-mm-dd
  kg       Float

  nutzer Nutzer @relation(fields: [nutzerId], references: [id], onDelete: Cascade)

  @@unique([nutzerId, datum])
}

// Fotos liegen als Datei unter backend/uploads/fotos/<nutzerId>/<dateiname> — nicht als
// Base64 im Datensatz (Punkt 3 aus der Review vom ersten Entwurf).
model Fortschrittsfoto {
  id         Int      @id @default(autoincrement())
  nutzerId   Int
  datum      String // yyyy-mm-dd
  dateiname  String
  erstelltAm DateTime @default(now())

  nutzer Nutzer @relation(fields: [nutzerId], references: [id], onDelete: Cascade)
}

model Aufgabe {
  id          Int       @id @default(autoincrement())
  nutzerId    Int
  bezeichnung String
  faelligAm   String? // yyyy-mm-dd
  erledigt    Boolean   @default(false)
  erledigtAm  DateTime?
  erstelltAm  DateTime  @default(now())

  nutzer Nutzer @relation(fields: [nutzerId], references: [id], onDelete: Cascade)
}

model Habit {
  id          Int      @id @default(autoincrement())
  nutzerId    Int
  bezeichnung String
  aktiv       Boolean  @default(true)
  erstelltAm  DateTime @default(now())

  nutzer    Nutzer         @relation(fields: [nutzerId], references: [id], onDelete: Cascade)
  eintraege HabitEintrag[]
}

model HabitEintrag {
  id       Int     @id @default(autoincrement())
  habitId  Int
  datum    String // yyyy-mm-dd
  erledigt Boolean @default(true)

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, datum])
}

// Persistierte, selbst eingetragene Überschreibung eines Essensplan-Slots — fehlt ein Eintrag,
// zeigt das Frontend stattdessen einen generierten Vorschlag (kein eigenes Modell nötig, da
// rein clientseitig berechnet).
model Planpunkt {
  id        Int    @id @default(autoincrement())
  nutzerId  Int
  wochentag Int // 0=Montag … 6=Sonntag
  mahlzeit  String // 'B' | 'L' | 'D'
  text      String

  nutzer Nutzer @relation(fields: [nutzerId], references: [id], onDelete: Cascade)

  @@unique([nutzerId, wochentag, mahlzeit])
}

// Cover kommt entweder von der Online-Buchsuche (coverUrl, öffentliche Open-Library-Bild-URL)
// oder ist ein eigenes Foto bei manueller Eingabe (coverDateiname) — analog zu Fortschrittsfoto
// unter backend/uploads/buchcover/<nutzerId>/, nur über authentifizierte Route abrufbar.
model Buch {
  id             Int      @id @default(autoincrement())
  nutzerId       Int
  titel          String
  autor          String?
  verlag         String?
  ausgabe        String?
  isbn           String?
  coverUrl       String?
  coverDateiname String?
  seitenzahl     Int?
  status         String   @default("wunschliste") // 'wunschliste' | 'am_lesen' | 'gelesen'
  aktuelleSeite  Int?
  bewertung      Int? // 1–5 Sterne, gilt für das Buch insgesamt (nicht pro Leserunde)
  // JSON-Array frei vergebener Tags (z. B. "Krimi", "Hörbuch") — analog zum Muster bei
  // Nutzer.deaktivierteModule, kein eigenes Tag-Modell nötig für eine persönliche Bibliothek.
  tags           String   @default("[]")
  erstelltAm     DateTime @default(now())

  nutzer     Nutzer      @relation(fields: [nutzerId], references: [id], onDelete: Cascade)
  notizen    BuchNotiz[]
  leserunden Leserunde[]
}

// Ein Buch kann mehrmals gelesen werden — begonnenAm/beendetAm liegen daher nicht mehr direkt
// am Buch, sondern pro Leserunde. Beim Wechsel auf Status "am_lesen" legt der Controller eine
// neue, offene Leserunde an (beendetAm noch leer); beim Wechsel auf "gelesen" wird die jeweils
// offene Leserunde geschlossen.
model Leserunde {
  id         Int     @id @default(autoincrement())
  buchId     Int
  begonnenAm String? // yyyy-mm-dd
  beendetAm  String? // yyyy-mm-dd

  buch Buch @relation(fields: [buchId], references: [id], onDelete: Cascade)
}

model BuchNotiz {
  id         Int      @id @default(autoincrement())
  buchId     Int
  nutzerId   Int
  text       String
  seite      Int?
  // JSON-Array frei vergebener Tags, gleiches Muster wie Buch.tags.
  tags       String   @default("[]")
  erstelltAm DateTime @default(now())

  buch   Buch   @relation(fields: [buchId], references: [id], onDelete: Cascade)
  nutzer Nutzer @relation(fields: [nutzerId], references: [id], onDelete: Cascade)

  verknuepfungenVon NotizVerknuepfung[] @relation("VerknuepfungVon")
  verknuepfungenZu  NotizVerknuepfung[] @relation("VerknuepfungZu")
}

// Verknüpfung zwischen zwei Notizen (auch über Bücher hinweg) — bewusst ungerichtet gedacht,
// der Controller legt beim Anlegen immer die kleinere id als notizVonId ab, damit @@unique
// doppelte Verknüpfungen in beiden Richtungen verhindert.
model NotizVerknuepfung {
  id         Int      @id @default(autoincrement())
  notizVonId Int
  notizZuId  Int
  erstelltAm DateTime @default(now())

  notizVon BuchNotiz @relation("VerknuepfungVon", fields: [notizVonId], references: [id], onDelete: Cascade)
  notizZu  BuchNotiz @relation("VerknuepfungZu", fields: [notizZuId], references: [id], onDelete: Cascade)

  @@unique([notizVonId, notizZuId])
}
